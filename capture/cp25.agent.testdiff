diff --git a/project-archive.spec.ts b/project-archive.spec.ts
new file mode 100644
index 0000000..83610af
--- /dev/null
+++ b/project-archive.spec.ts
@@ -0,0 +1,230 @@
+// Acceptance test for the change request:
+//   "Do not really delete a project. Just tuck it away so it drops off my lists. Keep it off the
+//    main project list and off the list on the client's page. I do not want to lose anything.
+//    Note it when I do."
+//
+// Archiving is a NON-destructive "tuck away", distinct from deleting. Each project row offers a
+// control to archive it (project-archive-<id>). Archiving:
+//   * drops the project from the main projects list (projects-table / project-row-<id>),
+//   * drops it from the list on its client's detail page (client-projects-table),
+//   * is held by the SERVER (it survives a fresh load),
+//   * keeps a record — exactly one audit record `PROJECT_ARCHIVED id=<id>` per archive,
+//   * LOSES NOTHING: the projects page carries a Show-archived toggle (projects-show-archived)
+//     that reveals archived projects again.
+// Archiving one project must not touch its siblings, and merely viewing or revealing a list records
+// nothing — only the archive action itself does.
+//
+// Asserts ONLY through the two public channels: the UI (data-testid) and the audit file
+// (auditLines()). Data is arranged via resetAndSeed (the app's /__test__ endpoint): `clients`
+// honours { id, name, email } and `projects` honours { id, name, clientId, archived }.
+import { test, expect, type Page } from '@playwright/test';
+import { resetAndSeed } from '../support/seed';
+import { auditLines } from '../support/audit';
+
+const projectRows = (page: Page) => page.locator('[data-testid^="project-row-"]');
+
+// The audit record for one archive — carries the project's id and nothing else; matched exactly.
+const archivedRecord = (id: number) => `PROJECT_ARCHIVED id=${id}`;
+
+const archivedRecordsFor = (id: number): string[] =>
+  auditLines().filter((line) => line === archivedRecord(id));
+
+test.describe('Archive a project', () => {
+  test('archiving a project drops it from the list, persists, keeps the project, and records it once', async ({
+    page,
+  }) => {
+    await resetAndSeed({
+      clients: [{ id: 1, name: 'Acme Corp', email: 'hello@acme.test' }],
+      projects: [{ id: 1, name: 'Website Redesign', clientId: 1 }],
+    });
+
+    await page.goto('/projects');
+    await expect(page.getByTestId('projects-page')).toBeVisible();
+
+    // The project is listed and offers a control to archive it; the page offers the Show-archived
+    // toggle that will later reveal it again.
+    await expect(projectRows(page)).toHaveCount(1);
+    await expect(page.getByTestId('project-row-1')).toBeVisible();
+    const archive = page.getByTestId('project-archive-1');
+    await expect(archive).toBeVisible();
+    await expect(page.getByTestId('projects-show-archived')).toBeVisible();
+
+    // Nothing has been recorded yet — reset clears the audit file, so the record below is proof the
+    // archiving (not the seeding) wrote it.
+    expect(auditLines()).toEqual([]);
+
+    await archive.click();
+
+    // The project drops off the main list — tucked away, it is the only project so the list is now
+    // empty.
+    await expect(page.getByTestId('project-row-1')).toHaveCount(0);
+    await expect(projectRows(page)).toHaveCount(0);
+    await expect(page.getByTestId('projects-empty')).toBeVisible();
+
+    // Exactly one record was kept for this archive, carrying the project's id.
+    expect(archivedRecordsFor(1)).toHaveLength(1);
+    expect(auditLines()).toHaveLength(1);
+
+    // The tuck-away is held by the server, not just the page: it survives a fresh load, and merely
+    // viewing the list does not record the archive a second time.
+    await page.reload();
+    await expect(page.getByTestId('project-row-1')).toHaveCount(0);
+    await expect(page.getByTestId('projects-empty')).toBeVisible();
+    expect(archivedRecordsFor(1)).toHaveLength(1);
+    expect(auditLines()).toHaveLength(1);
+
+    // Nothing was lost: revealing archived projects brings it back, still carrying its name. And
+    // revealing is a view — it records nothing.
+    await page.getByTestId('projects-show-archived').click();
+    await expect(page.getByTestId('project-row-1')).toBeVisible();
+    await expect(page.getByTestId('project-row-1').getByTestId('project-name')).toHaveText(
+      'Website Redesign',
+    );
+    await expect(page.getByTestId('projects-empty')).toHaveCount(0);
+    expect(archivedRecordsFor(1)).toHaveLength(1);
+    expect(auditLines()).toHaveLength(1);
+  });
+
+  test('archiving one project leaves the others on the list, and each archive keeps its own record', async ({
+    page,
+  }) => {
+    await resetAndSeed({
+      clients: [
+        { id: 1, name: 'Acme Corp', email: 'hello@acme.test' },
+        { id: 2, name: 'Globex', email: 'contact@globex.test' },
+      ],
+      projects: [
+        { id: 1, name: 'Website Redesign', clientId: 1 },
+        { id: 2, name: 'Mobile App', clientId: 2 },
+        { id: 3, name: 'Billing System', clientId: 1 },
+      ],
+    });
+
+    await page.goto('/projects');
+    await expect(projectRows(page)).toHaveCount(3);
+    expect(auditLines()).toEqual([]);
+
+    // Archive the middle project.
+    await page.getByTestId('project-archive-2').click();
+
+    // Only that project is tucked away; its siblings remain, each still carrying its name and client.
+    await expect(page.getByTestId('project-row-2')).toHaveCount(0);
+    await expect(projectRows(page)).toHaveCount(2);
+    await expect(page.getByTestId('project-row-1').getByTestId('project-name')).toHaveText(
+      'Website Redesign',
+    );
+    await expect(page.getByTestId('project-row-1').getByTestId('project-client')).toHaveText(
+      'Acme Corp',
+    );
+    await expect(page.getByTestId('project-row-3').getByTestId('project-name')).toHaveText(
+      'Billing System',
+    );
+
+    // Exactly one record so far, for the project that was archived.
+    expect(archivedRecordsFor(2)).toHaveLength(1);
+    expect(auditLines()).toHaveLength(1);
+
+    // Archive another project — a second record is kept, independent of the first.
+    await page.getByTestId('project-archive-1').click();
+    await expect(page.getByTestId('project-row-1')).toHaveCount(0);
+    await expect(projectRows(page)).toHaveCount(1);
+    await expect(page.getByTestId('project-row-3')).toBeVisible();
+
+    expect(archivedRecordsFor(2)).toHaveLength(1);
+    expect(archivedRecordsFor(1)).toHaveLength(1);
+    expect(auditLines()).toHaveLength(2);
+
+    // The tuck-aways survive a fresh load: only the un-archived project remains on the list.
+    await page.reload();
+    await expect(projectRows(page)).toHaveCount(1);
+    await expect(page.getByTestId('project-row-3')).toBeVisible();
+    await expect(page.getByTestId('project-row-1')).toHaveCount(0);
+    await expect(page.getByTestId('project-row-2')).toHaveCount(0);
+    expect(auditLines()).toHaveLength(2);
+
+    // Nothing was lost: revealing archived projects brings both back, so all three are shown again.
+    await page.getByTestId('projects-show-archived').click();
+    await expect(projectRows(page)).toHaveCount(3);
+    await expect(page.getByTestId('project-row-1')).toBeVisible();
+    await expect(page.getByTestId('project-row-2')).toBeVisible();
+    await expect(page.getByTestId('project-row-3')).toBeVisible();
+    // Revealing is a view — it records nothing.
+    expect(auditLines()).toHaveLength(2);
+  });
+
+  test('a project seeded archived starts off the list and is revealed by the Show-archived toggle', async ({
+    page,
+  }) => {
+    await resetAndSeed({
+      clients: [{ id: 1, name: 'Acme Corp', email: 'hello@acme.test' }],
+      projects: [
+        { id: 1, name: 'Active Work', clientId: 1 },
+        // Already tucked away: it must not show on the list until archived projects are revealed.
+        { id: 2, name: 'Tucked Away', clientId: 1, archived: true },
+      ],
+    });
+
+    await page.goto('/projects');
+    await expect(page.getByTestId('projects-page')).toBeVisible();
+    await expect(page.getByTestId('projects-table')).toBeVisible();
+
+    // Only the un-archived project is listed by default; the archived one is off the list.
+    await expect(projectRows(page)).toHaveCount(1);
+    await expect(page.getByTestId('project-row-1')).toBeVisible();
+    await expect(page.getByTestId('project-row-1').getByTestId('project-name')).toHaveText(
+      'Active Work',
+    );
+    await expect(page.getByTestId('project-row-2')).toHaveCount(0);
+    await expect(page.getByTestId('projects-page')).not.toContainText('Tucked Away');
+
+    // Seeding an archived project is not an archive action — nothing is recorded.
+    expect(auditLines()).toEqual([]);
+
+    // Revealing archived projects brings the tucked-away one back alongside the active one.
+    await page.getByTestId('projects-show-archived').click();
+    await expect(projectRows(page)).toHaveCount(2);
+    await expect(page.getByTestId('project-row-1')).toBeVisible();
+    await expect(page.getByTestId('project-row-2')).toBeVisible();
+    await expect(page.getByTestId('project-row-2').getByTestId('project-name')).toHaveText(
+      'Tucked Away',
+    );
+
+    // Revealing is a view — it records nothing.
+    expect(auditLines()).toEqual([]);
+  });
+
+  test("an archived project is kept off the list on its client's detail page", async ({ page }) => {
+    await resetAndSeed({
+      clients: [
+        { id: 1, name: 'Acme Corp', email: 'hello@acme.test' },
+        { id: 2, name: 'Globex', email: 'contact@globex.test' },
+      ],
+      projects: [
+        { id: 1, name: 'Website Redesign', clientId: 1 },
+        // Archived project for this same client — it must not appear on the client's page.
+        { id: 2, name: 'Tucked Away', clientId: 1, archived: true },
+        // A different client's project — never on this client's page regardless of archived state.
+        { id: 3, name: 'Mobile App', clientId: 2 },
+      ],
+    });
+
+    await page.goto('/clients/1');
+
+    await expect(page.getByTestId('client-detail-page')).toBeVisible();
+    await expect(page.getByTestId('client-projects-table')).toBeVisible();
+
+    // Only this client's un-archived project is listed; the archived one is off the list.
+    await expect(projectRows(page)).toHaveCount(1);
+    await expect(page.getByTestId('project-row-1').getByTestId('project-name')).toHaveText(
+      'Website Redesign',
+    );
+    await expect(page.getByTestId('project-row-2')).toHaveCount(0);
+    await expect(page.getByTestId('client-detail-page')).not.toContainText('Tucked Away');
+    // And the other client's project never leaks in.
+    await expect(page.getByTestId('project-row-3')).toHaveCount(0);
+    await expect(page.getByTestId('client-detail-page')).not.toContainText('Mobile App');
+
+    // No archive action happened here — nothing is recorded.
+    expect(auditLines()).toEqual([]);
+  });
+});
