       projects: [{ id: 1, clientId: 1, name: 'Website redesign' }],
-      invoices: [{ id: 1, projectId: 1, amount: 120, status: 'SENT' }],
+      invoices: [{ id: 1, projectId: 1, amount: 300, status: 'SENT' }],
