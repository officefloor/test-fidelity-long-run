         { id: 3, clientId: 2, name: 'Warehouse automation' },
       ],
       invoices: [
-        // Unpaid invoices across several projects -> still owed = 120 + 300 + 55 = 475.
-        { id: 1, projectId: 1, amount: 120, status: 'UNPAID' },
