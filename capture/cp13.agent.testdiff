+        { id: 2, projectId: 1, amount: 300, status: 'SENT' },
+        { id: 3, projectId: 1, amount: 55, status: 'SENT' },
         // PAID -> not owed, not counted.
         { id: 4, projectId: 1, amount: 999, status: 'PAID' },
