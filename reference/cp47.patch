diff --git a/src/main/frontend/features/invoices/invoiceSummary.ts b/src/main/frontend/features/invoices/invoiceSummary.ts
new file mode 100644
index 0000000..255977c
--- /dev/null
+++ b/src/main/frontend/features/invoices/invoiceSummary.ts
@@ -0,0 +1,25 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+
+// One invoice's money breakdown, worked out on the server (see InvoiceSummaryGetLogic): its subtotal
+// (the sum of its line items), the percentage discount taken off it, that discount in money, and the
+// final total (subtotal minus the discount). Keyed under the shared ['invoices'] prefix so adding or
+// removing a line — which invalidates ['invoices'] — also refreshes the breakdown, with no import
+// between the two.
+export type InvoiceSummary = {
+  invoiceId: number;
+  subtotal: number;
+  discountPct: number;
+  discount: number;
+  total: number;
+};
+
+export const invoiceSummaryKey = (invoiceId: number) =>
+  ['invoices', 'summary', invoiceId] as const;
+
+export function useInvoiceSummary(invoiceId: number) {
+  return useQuery({
+    queryKey: invoiceSummaryKey(invoiceId),
+    queryFn: () => getJson<InvoiceSummary>(`/api/invoices/summary?invoiceId=${invoiceId}`),
+  });
+}
diff --git a/src/main/frontend/features/invoices/summary.slot.tsx b/src/main/frontend/features/invoices/summary.slot.tsx
new file mode 100644
index 0000000..cc55add
--- /dev/null
