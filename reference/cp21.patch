+package net.officefloor.hq.app;
+
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+/** Data access for {@link LineItem}. Injected into the OfficeFloor REST logic classes. */
+public interface LineItemRepository extends JpaRepository<LineItem, Long> {
+
+    /** The line items for one invoice, oldest first, so an invoice's detail shows only its own. */
+    List<LineItem> findByInvoiceIdOrderByIdAsc(Long invoiceId);
+}
