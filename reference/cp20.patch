diff --git a/src/main/resources/db/migration/V12__tasks.sql b/src/main/resources/db/migration/V12__tasks.sql
new file mode 100644
index 0000000..2bd1cd5
--- /dev/null
+++ b/src/main/resources/db/migration/V12__tasks.sql
@@ -0,0 +1,8 @@
+-- Tasks: a checklist item on a project. Each task belongs to one project (project_id -> projects.id)
+-- and is either OPEN (done = FALSE, the default) or DONE (done = TRUE), ticked off as work completes.
+CREATE TABLE tasks (
+    id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    project_id BIGINT NOT NULL REFERENCES projects(id),
+    title      VARCHAR(255) NOT NULL,
+    done       BOOLEAN NOT NULL DEFAULT FALSE
+);
